{
  "name": "claude-code-artifact",
  "displayName": "Claude Code Artifact",
  "description": "Interactive Claude Code artifacts (such as implementation plans) in the IDE.",
  "publisher": "j-botros",
  "license": "MIT",
  "version": "0.0.1",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.107.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/j-botros/Claude-Code-Artifact-Extension.git"
  },
  "contributes": {
    "commands": [
      {
        "command": "claudeArtifact.openSamplePlan",
        "title": "Claude Artifact: Open Sample Plan"
      },
      {
        "command": "claudeArtifact.generatePlan",
        "title": "Claude Artifact: Generate Plan from Claude Code"
      },
      {
        "command": "claudeArtifact.acceptHunk",
        "title": "Claude Artifact: Accept Hunk"
      },
      {
        "command": "claudeArtifact.rejectHunk",
        "title": "Claude Artifact: Reject Hunk"
      },
      {
        "command": "claudeArtifact.applyAccepted",
        "title": "Claude Artifact: Apply Accepted Hunks"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "claudeArtifact.acceptHunk",
          "when": "false"
        },
        {
          "command": "claudeArtifact.rejectHunk",
          "when": "false"
        },
        {
          "command": "claudeArtifact.applyAccepted",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test:unit": "vitest run --passWithNoTests",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/vscode": "^1.107.0",
    "@vscode/vsce": "3.6.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
